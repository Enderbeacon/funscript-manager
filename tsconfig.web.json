{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "out/types-web",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@script-player/*": ["./src/script-player/*"],
      "@/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/preload/index.d.ts",
    "src/shared/**/*.ts",
    "src/script-player/domain/**/*.ts",
    "src/script-player/shared/**/*.ts",
    "src/script-player/interface/ipc/contract.ts",
    "src/script-player/interface/renderer/**/*.ts",
    "src/script-player/interface/renderer/**/*.tsx"
  ]
}
